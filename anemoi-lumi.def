Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-latest.sif

%labels
    Author Anis Rahman
    Description LAIF PyTorch container extended for Anemoi training on LUMI

%files
    scripts/anemoi-smoke.py /opt/anemoi-smoke.py

%post
    set -eux

    chmod a+rx /opt/anemoi-smoke.py

    python -m venv --system-site-packages /opt/anemoi-venv
    . /opt/anemoi-venv/bin/activate

    python -m pip install --no-cache-dir --upgrade \
        pip \
        setuptools \
        wheel

    # Pin the base ROCm torch stack so pip cannot swap in PyPI (CPU/CUDA) wheels.
    # Emit plain name==version lines (not pip freeze's "@ file://" form, which
    # makes pip try to reinstall from a wheel path that no longer exists).
    python - > /opt/rocm-constraints.txt <<'PY'
from importlib.metadata import PackageNotFoundError, version
for pkg in ("torch", "torchvision", "torchaudio", "pytorch-triton", "triton"):
    try:
        print(f"{pkg}=={version(pkg)}")
    except PackageNotFoundError:
        pass
PY

    python -m pip install --no-cache-dir -c /opt/rocm-constraints.txt \
        'anemoi-training==0.14.0' \
        'anemoi-models==0.16.0' \
        'anemoi-graphs==0.9.4' \
        'zarr<3' \
        'trimesh' \
        'pyshtools'

%environment
    export PATH=/opt/anemoi-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/anemoi-venv
    export PYTHONNOUSERSITE=1
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec python "$@"

%test
    python /opt/anemoi-smoke.py
