Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-u24r72f21m50t211-20260929_104918/lumi-multitorch-full-u24r72f21m50t211-20260929_104918.sif

%labels
    Author Anis Rahman
    Description LAIF PyTorch container extended for Anemoi training on LUMI

%files
    scripts/anemoi-smoke.py /opt/anemoi-smoke.py

%post
    set -eux

    chmod a+rx /opt/anemoi-smoke.py

    python -m venv --system-site-packages /opt/anemoi-venv
    . /opt/anemoi-venv/bin/activate

    python -m pip install --no-cache-dir --upgrade pip

    # Pin the base ROCm torch stack so pip cannot swap in PyPI (CPU/CUDA) wheels.
    # Emit plain name==version lines (not pip freeze's "@ file://" form, which
    # makes pip try to reinstall from a wheel path that no longer exists).
    python - > /opt/rocm-constraints.txt <<'PY'
from importlib.metadata import PackageNotFoundError, version
for pkg in ("torch", "torchvision", "torchaudio", "pytorch-triton", "triton"):
    try:
        print(f"{pkg}=={version(pkg)}")
    except PackageNotFoundError:
        pass
PY

    # anemoi-core caps torch<2.11 (re-added in ecmwf/anemoi-core#1204 over
    # torch 2.12 compile changes), which excludes the base's torch 2.11. Pip
    # has no override mechanism, so install the anemoi packages without deps,
    # then install their requirements minus torch and the anemoi packages
    # themselves (following the extras they request from each other).
    python -m pip install --no-cache-dir --no-deps \
        'anemoi-training==0.16.0' \
        'anemoi-models==0.18.0' \
        'anemoi-graphs==0.9.6'

    python - > /opt/anemoi-deps.txt <<'PY'
import re
from importlib.metadata import requires
from packaging.requirements import Requirement

def norm(name):
    return re.sub(r"[-_.]+", "-", name).lower()

ANEMOI = {"anemoi-training", "anemoi-models", "anemoi-graphs"}
todo = [(name, frozenset()) for name in sorted(ANEMOI)]
# anemoi-training 0.16.0 imports datashader whenever the forecaster task loads,
# but only declares it in the "plotting" extra.
todo.append(("anemoi-training", frozenset({"plotting"})))
seen, deps = set(), set()
while todo:
    pkg, extras = todo.pop()
    if (pkg, extras) in seen:
        continue
    seen.add((pkg, extras))
    for line in requires(pkg) or []:
        req = Requirement(line)
        if req.marker and not any(req.marker.evaluate({"extra": e}) for e in {"", *extras}):
            continue
        name = norm(req.name)
        if name in ANEMOI:
            todo.append((name, frozenset(req.extras)))
        elif name != "torch":
            req.marker = None
            deps.add(str(req))
print("\n".join(sorted(deps)))
PY
    cat /opt/anemoi-deps.txt

    # torch-geometric>=2.8.0 is the first PyG release supporting torch 2.11.
    python -m pip install --no-cache-dir -c /opt/rocm-constraints.txt \
        -r /opt/anemoi-deps.txt \
        'torch-geometric>=2.8.0' \
        'zarr<3' \
        'trimesh' \
        'pyshtools'

%environment
    export PATH=/opt/anemoi-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/anemoi-venv
    export PYTHONNOUSERSITE=1

    # The LAIF base puts its own /opt/venv on PYTHONPATH (see
    # /.singularity.d/env/10-docker2singularity.sh, which is sourced before
    # this block). That entry precedes this venv's site-packages on sys.path,
    # so without the prepend below the base's copies shadow the pins installed
    # here -- notably zarr>=3, while anemoi-datasets requires zarr<3.
    for _sp in /opt/anemoi-venv/lib/python*/site-packages; do
        [ -d "$_sp" ] && PYTHONPATH="$_sp${PYTHONPATH:+:$PYTHONPATH}"
    done
    export PYTHONPATH
    unset _sp

    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec python "$@"

%test
    python /opt/anemoi-smoke.py
