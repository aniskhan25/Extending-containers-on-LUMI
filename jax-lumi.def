Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-u24r70f21m50t210-20260513_121430/lumi-multitorch-mpich-u24r70f21m50t210-20260513_121430.sif

%labels
    Author Anis Rahman
    Description LAIF MPICH container extended with JAX (ROCm) for LUMI MI250x

# MI250x (gfx90a/CDNA2) NOTES
# ----------------------------
# The mpich base provides ROCm 7.x, libfabric, and MPICH.
# JAX dropped official ROCm wheels (jax_rocm.html is gone); GPU support is
# now provided by AMD's plugin packages from repo.radeon.com, pinned to the
# ROCm version in the base container.

%files
    scripts/jax-smoke.py /opt/jax-smoke.py

%post
    set -eux

    chmod a+rx /opt/jax-smoke.py

    python3 -m venv /opt/jax-venv
    . /opt/jax-venv/bin/activate

    python3 -m pip install --no-cache-dir --upgrade \
        pip \
        setuptools \
        wheel

    # Core JAX — version must match the AMD plugin packages below
    python3 -m pip install --no-cache-dir \
        "jax==0.6.0" \
        optax \
        flax

    # ROCm 7 GPU backend — AMD-maintained plugins for ROCm 7.0.2
    python3 -m pip install --no-cache-dir \
        --find-links https://repo.radeon.com/rocm/manylinux/rocm-rel-7.0.2/ \
        jax_rocm7_plugin \
        jax_rocm7_pjrt

%environment
    export PATH=/opt/jax-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/jax-venv
    export PYTHONNOUSERSITE=1
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec python3 "$@"

%test
    python3 /opt/jax-smoke.py
