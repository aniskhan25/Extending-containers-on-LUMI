Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-u24r70f21m50t210-20260513_121430/lumi-multitorch-mpich-u24r70f21m50t210-20260513_121430.sif

%labels
    Author Anis Rahman
    Description LAIF MPICH container extended with JAX (ROCm) for LUMI MI250x

# MI250x (gfx90a/CDNA2) NOTES
# ----------------------------
# JAX provides pre-built ROCm wheels at storage.googleapis.com/jax-releases.
# The mpich base is used instead of the full torch container because JAX does
# not depend on PyTorch and the mpich layer already provides ROCm, libfabric,
# and MPICH — everything needed for single- and multi-GPU JAX workloads.

%files
    scripts/jax-smoke.py /opt/jax-smoke.py

%post
    set -eux

    chmod a+rx /opt/jax-smoke.py

    python3 -m venv --system-site-packages /opt/jax-venv
    . /opt/jax-venv/bin/activate

    python3 -m pip install --no-cache-dir --upgrade \
        pip \
        setuptools \
        wheel

    python3 -m pip install --no-cache-dir \
        "jax[rocm]" \
        -f https://storage.googleapis.com/jax-releases/jax_rocm.html

    python3 -m pip install --no-cache-dir \
        optax \
        flax

%environment
    export PATH=/opt/jax-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/jax-venv
    export PYTHONNOUSERSITE=1
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec python3 "$@"

%test
    python3 /opt/jax-smoke.py
