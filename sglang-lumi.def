Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-latest.sif
    SGLANG_VERSION=v0.5.6.post2

%labels
    Author Anis Rahman
    Description LAIF PyTorch container extended with SGLang (source build, MI250x/gfx90a)

# MI250x (gfx90a/CDNA2) COMPATIBILITY NOTES
# ------------------------------------------
# SGLang's default pyproject.toml targets CUDA and includes NVIDIA/CUDA-only
# deps (flashinfer, sgl-kernel, nvidia-cutlass-dsl, etc.) that cannot build on
# ROCm.  The repo ships pyproject_other.toml as the AMD variant: it removes
# those CUDA deps and replaces them with the HIP extras (petit_kernel,
# wave-lang).  Critically, it also removes aiter, which fails to build for
# gfx90a by default (ROCm/aiter#179).
#
# FlashInfer has no MI250x support; --attention-backend triton (set via
# SGLANG_ATTENTION_BACKEND below) is the only viable runtime path on gfx90a.

%post
    set -eux

    python -m venv --system-site-packages /opt/sglang-venv
    . /opt/sglang-venv/bin/activate

    python -m pip install --no-cache-dir --upgrade pip

    # ── clone SGLang at the pinned release ──────────────────────────────────
    rm -rf /tmp/sglang
    git clone --depth 1 --branch {{ SGLANG_VERSION }} \
        https://github.com/sgl-project/sglang.git /tmp/sglang

    cd /tmp/sglang

    # Swap in the AMD pyproject before pip sees it.
    # pyproject_other.toml removes all CUDA/NVIDIA deps and aiter, and defines
    # the all_hip extra with only ROCm-compatible packages.
    rm python/pyproject.toml
    mv python/pyproject_other.toml python/pyproject.toml

    # Install SGLang with all AMD/HIP extras (petit_kernel, wave-lang, etc.).
    # Do NOT pass --no-deps — the extras in pyproject_other[all_hip] are needed
    # at runtime; skipping them produces a broken install that imports but fails.
    # --no-build-isolation exposes the venv's ROCm PyTorch to any C extensions.
    pip install --no-cache-dir --no-build-isolation "./python[all_hip]"

    # ── sgl_kernel stub for ROCm ────────────────────────────────────────────
    # pyproject_other.toml removes sgl-kernel because the PyPI wheel is
    # CUDA-only and the source build requires nvcc (its CMakeLists.txt declares
    # CUDA as the project language and fails without it).
    # SGLang still imports sgl_kernel unconditionally in several files, but the
    # actual kernel calls are guarded by is_hip() checks — the compiled kernels
    # are not invoked on the ROCm code path (Triton/petit_kernel handle those
    # operations instead).  A minimal stub satisfies the import.
    python - <<'PY'
from pathlib import Path
import sglang

stub_dir = Path(sglang.__file__).parent.parent / "sgl_kernel"
stub_dir.mkdir(exist_ok=True)
(stub_dir / "__init__.py").write_text(
    "# Stub for MI250x/gfx90a: sgl-kernel requires nvcc and cannot be built\n"
    "# on ROCm-only systems.  SGLang's ROCm code paths use Triton/petit_kernel\n"
    "# instead of these compiled kernels.\n"
    "# MetaPathFinder intercepts 'import sgl_kernel.*' at any nesting depth.\n"
    "import sys, types\n"
    "from importlib.abc import MetaPathFinder, Loader\n"
    "from importlib.machinery import ModuleSpec\n"
    "\n"
    "class _StubLoader(Loader):\n"
    "    def create_module(self, spec):\n"
    "        mod = types.ModuleType(spec.name)\n"
    "        mod.__package__ = spec.parent\n"
    "        mod.__path__ = []\n"
    "        return mod\n"
    "    def exec_module(self, module):\n"
    "        def __getattr__(name):\n"
    "            return _get_stub(f'{module.__name__}.{name}')\n"
    "        module.__getattr__ = __getattr__\n"
    "\n"
    "class _StubFinder(MetaPathFinder):\n"
    "    def find_spec(self, fullname, path, target=None):\n"
    "        if fullname.startswith('sgl_kernel.'):\n"
    "            return ModuleSpec(fullname, _StubLoader(), is_package=True)\n"
    "        return None\n"
    "\n"
    "def _get_stub(fullname):\n"
    "    if fullname not in sys.modules:\n"
    "        loader = _StubLoader()\n"
    "        spec = ModuleSpec(fullname, loader, is_package=True)\n"
    "        mod = loader.create_module(spec)\n"
    "        loader.exec_module(mod)\n"
    "        sys.modules[fullname] = mod\n"
    "    return sys.modules[fullname]\n"
    "\n"
    "sys.meta_path.insert(0, _StubFinder())\n"
)
print(f"Created sgl_kernel stub at {stub_dir}")

# aiter is not installed (fails to build for gfx90a, ROCm/aiter#179).
# SGLANG_USE_AITER=0 disables aiter code paths at runtime, but some files
# import the module unconditionally at the top level.
aiter_dir = Path(sglang.__file__).parent.parent / "aiter"
aiter_dir.mkdir(exist_ok=True)
(aiter_dir / "__init__.py").write_text(
    "# Stub for MI250x/gfx90a: aiter fails to build for gfx90a (ROCm/aiter#179).\n"
    "# SGLANG_USE_AITER=0 disables aiter code paths at runtime, but SGLang\n"
    "# imports aiter submodules unconditionally at module level (e.g.\n"
    "# 'from aiter.ops.triton.gemm_afp4wfp4 import gemm_afp4wfp4').\n"
    "# __getattr__ does not intercept submodule imports -- Python's import\n"
    "# machinery bypasses it. A MetaPathFinder inserted into sys.meta_path\n"
    "# intercepts any 'aiter.*' import at the loader level.\n"
    "import sys, types\n"
    "from importlib.abc import MetaPathFinder, Loader\n"
    "from importlib.machinery import ModuleSpec\n"
    "\n"
    "class _StubLoader(Loader):\n"
    "    def create_module(self, spec):\n"
    "        mod = types.ModuleType(spec.name)\n"
    "        mod.__package__ = spec.parent\n"
    "        mod.__path__ = []\n"
    "        return mod\n"
    "    def exec_module(self, module):\n"
    "        def __getattr__(name):\n"
    "            return _get_stub(f'{module.__name__}.{name}')\n"
    "        module.__getattr__ = __getattr__\n"
    "\n"
    "class _StubFinder(MetaPathFinder):\n"
    "    def find_spec(self, fullname, path, target=None):\n"
    "        if fullname.startswith('aiter.'):\n"
    "            return ModuleSpec(fullname, _StubLoader(), is_package=True)\n"
    "        return None\n"
    "\n"
    "def _get_stub(fullname):\n"
    "    if fullname not in sys.modules:\n"
    "        loader = _StubLoader()\n"
    "        spec = ModuleSpec(fullname, loader, is_package=True)\n"
    "        mod = loader.create_module(spec)\n"
    "        loader.exec_module(mod)\n"
    "        sys.modules[fullname] = mod\n"
    "    return sys.modules[fullname]\n"
    "\n"
    "sys.meta_path.insert(0, _StubFinder())\n"
)
print(f"Created aiter stub at {aiter_dir}")
PY

    # ── patch get_amdgpu_memory_capacity for MI250x ─────────────────────────
    # SGLang queries GPU memory via `rocminfo | grep ... | awk ...` during
    # argument parsing.  On MI250x/gfx90a the rocminfo output format does not
    # match the grep pattern, producing an empty string.  The except clause only
    # catches FileNotFoundError, so the ValueError from float('') propagates and
    # crashes the server before it starts.
    #
    # The NVIDIA path already has the same torch.cuda.mem_get_info() fallback;
    # this patch adds it to the AMD path and broadens the except to catch
    # ValueError as well.
    python - <<'PY'
import re
from pathlib import Path
import sglang.srt.utils.common as m

path = Path(m.__file__)
src = path.read_text()

old = '''    except FileNotFoundError:
        raise RuntimeError(
            "rocm-smi not found. Ensure AMD ROCm drivers are installed and accessible."
        )'''

new = '''    except (FileNotFoundError, ValueError):
        # Fallback for MI250x/gfx90a: rocminfo output does not match the
        # expected grep pattern, so the list comprehension produces float('')
        # which raises ValueError.  Mirror the NVIDIA path's torch fallback.
        if torch.cuda.is_available():
            logger.warning(
                "Failed to get GPU memory capacity from rocminfo, "
                "falling back to torch.cuda.mem_get_info()."
            )
            return torch.cuda.mem_get_info()[1] // 1024 // 1024  # unit: MB
        raise RuntimeError(
            "Cannot determine AMD GPU memory capacity. "
            "Ensure you have a GPU allocation (--gpus-per-node in srun/sbatch)."
        )'''

assert old in src, f"Patch target not found in {path} — check SGLang version"
path.write_text(src.replace(old, new, 1))
print(f"Patched {path}")
PY

    rm -rf /tmp/sglang

%environment
    export PATH=/opt/sglang-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/sglang-venv
    export PYTHONNOUSERSITE=1

    # Runtime: disable aiter (not installed; only meaningful on MI300X+).
    export SGLANG_USE_AITER=0

    # Runtime: Triton is the only supported attention backend on MI250x.
    # FlashInfer is not installed and has no gfx90a support.
    export SGLANG_ATTENTION_BACKEND=triton

    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%test
    python - <<'PY'
import importlib
import torch

for name in ("sglang", "torch", "triton"):
    try:
        m = importlib.import_module(name)
        print(f"{name}: {getattr(m, '__version__', 'unknown')}")
    except ImportError as e:
        raise SystemExit(f"{name} not importable: {e}")

if "+rocm" not in torch.__version__:
    raise SystemExit("expected LAIF ROCm PyTorch to remain visible in venv")

print(f"torch.cuda.is_available: {torch.cuda.is_available()}")
print(f"GPU count: {torch.cuda.device_count()}")
PY
