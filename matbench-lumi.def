Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-latest.sif

%labels
    Author Anis Rahman
    Description LAIF PyTorch container extended for Matbench Discovery on LUMI

%post
    set -eux

    python -m venv --system-site-packages /opt/matbench-venv
    . /opt/matbench-venv/bin/activate

    python -m pip install --no-cache-dir --upgrade pip

    python -m pip install --no-cache-dir \
        'matbench-discovery==1.3.1'

    python - <<'PY'
from pathlib import Path
from importlib.util import find_spec

spec = find_spec("matbench_discovery")
if spec is None or spec.origin is None:
    raise SystemExit("matbench_discovery package not found after install")

pkg_dir = Path(spec.origin).parent
for rel_path in (
    "data/mp",
    "data/wbm",
    "paper/figs",
    "site/src/figs",
    "site/src/lib",
    "wandb/checkpoints",
):
    (pkg_dir / rel_path).mkdir(parents=True, exist_ok=True)
PY

    python -m pip check

%environment
    export PATH=/opt/matbench-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/matbench-venv
    export PYTHONNOUSERSITE=1
    export MPLCONFIGDIR=${MPLCONFIGDIR:-/tmp/matplotlib-${USER:-matbench}}
    export MBD_CACHE_DIR=${MBD_CACHE_DIR:-/tmp/matbench-discovery-${USER:-matbench}}
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%test
    mkdir -p "$MPLCONFIGDIR" "$MBD_CACHE_DIR"
    python - <<'PY'
import importlib

for module_name in ("matbench_discovery", "ase", "pymatgen", "numpy", "torch"):
    module = importlib.import_module(module_name)
    print(f"{module_name}: {getattr(module, '__version__', 'unknown')}")
PY
