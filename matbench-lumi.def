Bootstrap: localimage
From: {{ LAIF_BASE }}

%arguments
    LAIF_BASE=/appl/local/laifs/containers/lumi-multitorch-latest.sif

%labels
    Author Anis Rahman
    Description LAIF PyTorch container extended for Matbench Discovery on LUMI

%files
    scripts/matbench-smoke.py /opt/matbench-smoke.py

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libblas-dev \
        liblapack-dev \
        pkg-config \
        python3-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python -m venv --system-site-packages /opt/matbench-venv
    . /opt/matbench-venv/bin/activate

    python -m pip install --no-cache-dir --upgrade \
        pip \
        setuptools \
        wheel \
        packaging

    python -m pip install --no-cache-dir \
        'matbench-discovery[fetch-wbm-data,phonons]==1.3.1' \
        'mace-torch>=0.3.6' \
        'chgnet>=0.3.0'

    python -m pip check

%environment
    export PATH=/opt/matbench-venv/bin:$PATH
    export VIRTUAL_ENV=/opt/matbench-venv
    export PYTHONNOUSERSITE=1
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

%runscript
    exec python "$@"

%test
    python /opt/matbench-smoke.py
